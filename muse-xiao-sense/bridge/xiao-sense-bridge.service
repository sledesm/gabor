# Runs the XIAO bridge next to the musegadget service.
# Install: copy xiao_sense_bridge.py to /opt/xiao-sense/, create its venv
# (python3 -m venv /opt/xiao-sense/venv && /opt/xiao-sense/venv/bin/pip install bleak),
# set User= to the account musegadget runs commands as, then
#   sudo cp xiao-sense-bridge.service /etc/systemd/system/
#   sudo systemctl enable --now xiao-sense-bridge
[Unit]
Description=Muse bridge for a Seeed XIAO nRF52840 Sense
After=bluetooth.target musegadget.service
Wants=bluetooth.target

[Service]
User=pi
RuntimeDirectory=xiao-sense
RuntimeDirectoryMode=0750
ExecStart=/opt/xiao-sense/venv/bin/python /opt/xiao-sense/xiao_sense_bridge.py run
# Post events to a side chat instead of the main one:
#Environment=XIAO_SENSE_SESSION_ID=6f1c2d4e-0b7a-4c3e-9f5d-2a8b1e0c7d93
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
