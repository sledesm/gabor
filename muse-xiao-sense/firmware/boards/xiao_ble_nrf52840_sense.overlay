/*
 * Muse gadget wiring on the XIAO nRF52840 Sense.
 *
 * Wi-Fi: an ESP32 running Espressif's ESP-AT firmware on UART0
 *   XIAO D6 (TX, P1.11) -> ESP RX, XIAO D7 (RX, P1.12) <- ESP TX, GND, 3V3.
 * Button: optional, between D1 (P0.03) and GND.
 */

&uart0 {
	status = "okay";
	current-speed = <115200>;

	esp_wifi: esp-wifi {
		compatible = "espressif,esp-at";
		status = "okay";
	};
};

/* The RGB LED on three PWM channels so it can mix colours. */
&pwm0_default {
	group1 {
		psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
			<NRF_PSEL(PWM_OUT1, 0, 30)>,
			<NRF_PSEL(PWM_OUT2, 0, 6)>;
	};
};

&pwm0_sleep {
	group1 {
		psels = <NRF_PSEL(PWM_OUT0, 0, 26)>,
			<NRF_PSEL(PWM_OUT1, 0, 30)>,
			<NRF_PSEL(PWM_OUT2, 0, 6)>;
		low-power-enable;
	};
};

/ {
	muse_rgb {
		compatible = "pwm-leds";
		muse_red: muse_red {
			pwms = <&pwm0 0 PWM_MSEC(2) PWM_POLARITY_INVERTED>;
		};
		muse_green: muse_green {
			pwms = <&pwm0 1 PWM_MSEC(2) PWM_POLARITY_INVERTED>;
		};
		muse_blue: muse_blue {
			pwms = <&pwm0 2 PWM_MSEC(2) PWM_POLARITY_INVERTED>;
		};
	};

	zephyr,user {
		io-channels = <&adc 7>;
		/* Held asserted (low): enables the VBAT divider on P0.31. */
		vbat-enable-gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
		/* BQ25101 ~CHG, low while charging. */
		charging-gpios = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		button-gpios = <&gpio0 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};
};

/* The board file configures the PDM microphone but leaves it disabled. */
&pdm0 {
	status = "okay";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>;
		zephyr,resolution = <12>;
	};
};
